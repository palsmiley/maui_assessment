<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XamarinFormsAssesment.AddEntryPage"
             Title="Add Entry">
    
    <VerticalStackLayout Padding="40" Spacing="30">
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto"
                ColumnDefinitions="*, *">

            <Label Text="First Name" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
            <Entry x:Name="firstName" Grid.Row="0" Grid.Column="1" VerticalOptions="Center"/>

            <Label Text="Last Name" Grid.Row="1" Grid.Column="0" VerticalOptions="Center"/>
            <Entry x:Name="lastName" Grid.Row="1" Grid.Column="1" VerticalOptions="Center"/>

            <Label Text="Date of Birth" Grid.Row="2" Grid.Column="0" VerticalOptions="Center"/>
            <DatePicker x:Name="dateOfBirth" Grid.Row="2" Grid.Column="1" VerticalOptions="Center"/>
        </Grid>

        <Button x:Name="addNewEntry" Text="Add" Margin="5" Grid.Row="6" Grid.Column="1" Clicked="OnNewButtonClicked"/>
    </VerticalStackLayout>

</ContentPage>